# Copy to .env.dev (git-ignored). Development values only.
DB_URL=postgresql://postgres:postgres@db:5432/classquiz
REDIS=redis://redis:6379/0?decode_responses=True
MEILISEARCH_URL=http://meilisearch:7700
SECRET_KEY=replace-me-with-openssl-rand-hex-32
MAX_WORKERS=1
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Where the frontend lives (used in links/emails). Vite dev server:
ROOT_ADDRESS=http://localhost:5173

# Upstream sends telemetry by default. Keep it off.
TELEMETRY_ENABLED=False

# No real mail server in dev; users are active immediately.
SKIP_EMAIL_VERIFICATION=True
MAIL_ADDRESS=dev@localhost
MAIL_USERNAME=dev@localhost
MAIL_PASSWORD=dev
MAIL_SERVER=localhost
MAIL_PORT=587

STORAGE_BACKEND=local
STORAGE_PATH=/app/data
