{
  "mcpServers": {
    "brave-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--executablePath=/Applications/Brave Browser.app/Contents/MacOS/Brave Browser",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "shadcn": {
      "type": "stdio",
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    }
  }
}
